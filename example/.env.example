# UID:GID the Fuseki server runs as. Set these to your host user's ids
# (check with:  id -u   and   id -g).
#
# The data volume (./run) is chowned to this user at startup, and your read-only
# inputs (./input, ./resources) must be readable by this user.
WANT_UID=1000
WANT_GID=1000

# Optional: the gid of your docker group (check with: getent group docker | cut -d: -f3).
# Only needed if you use a plugin that controls other containers (e.g. Qlever).
# DOCKER_GID=
